# ── V2：本地模式（RPi5 / Orange Pi 5）──────────────────
# 全程离线，Gemma 4 E2B 本地推理
# 适合：硬件设备，无需网络连接

# RPi5 用 ollama，Orange Pi 5 用 rkllama
RUNTIME_MODE=ollama
# RUNTIME_MODE=rkllama  # Orange Pi 5 NPU（未来）

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Orange Pi 5 NPU 服务地址（RUNTIME_MODE=rkllama 时用）
RKLLAMA_BASE_URL=http://localhost:8080

# STT 用 faster-whisper local（small 在 RPi5 推荐）
WHISPER_MODEL=small

# Supabase 云同步（可选，有网时自动同步）
SUPABASE_URL=https://httcwecrquezqzvjxgbf.supabase.co
SUPABASE_SERVICE_KEY=你的key
PIXEL_USER_ID=你的user-uuid

# 降级备用（本地失败时自动切云端，留空则不降级）
XAI_API_KEY=
