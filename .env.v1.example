# ── V1：云端模式（无硬件 / 无本地 GPU）─────────────────
# 使用 xAI Grok API，Deepgram STT
# 适合：Mac 开发测试，没有 RPi5 的时候

RUNTIME_MODE=cloud
XAI_API_KEY=xai-你的key

# STT 用 Whisper local（tiny 最快）
WHISPER_MODEL=tiny

# Supabase 云同步（可选）
SUPABASE_URL=https://httcwecrquezqzvjxgbf.supabase.co
SUPABASE_SERVICE_KEY=你的key
PIXEL_USER_ID=你的user-uuid
