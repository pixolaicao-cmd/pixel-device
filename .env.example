# Pixel 设备配置（复制为 .env 并填写）

# AI 模型（默认 gemma4:e2b）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Whisper 模型大小: tiny / base / small / medium
# 树莓派推荐 small；Mac 开发用 base 更快
WHISPER_MODEL=small

# Supabase 云同步（可留空，不影响本地运行）
SUPABASE_URL=https://httcwecrquezqzvjxgbf.supabase.co
SUPABASE_SERVICE_KEY=
PIXEL_USER_ID=   # 你的 Supabase user UUID
